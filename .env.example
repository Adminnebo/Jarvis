# Copia este archivo como .env y pon tus claves reales.

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-pon-tu-clave-aqui

# Modo texto. Barato, para lo cotidiano.
OPENAI_MODEL=gpt-5.6-terra

# Modo voz en vivo. El flagship distingue mejor la voz del ruido de fondo y
# acierta mas con nombres tecnicos; el mini cuesta un tercio.
OPENAI_MODELO_VOZ=gpt-realtime-2.1
JARVIS_VOZ=marin

# Cuanto piensa antes de hablar: minimal, low, medium, high, xhigh.
# 'low' es lo recomendado para voz.
JARVIS_ESFUERZO=low

# --- Como escucha ---
# far_field: microfono de portatil o de sala.  near_field: diadema.
JARVIS_MICROFONO=far_field
# Que tan fuerte hay que hablar para que cuente como voz (0 a 1).
JARVIS_UMBRAL_VOZ=0.55
# Silencio necesario para dar tu turno por terminado.
JARVIS_SILENCIO_MS=700
# true = puedes cortarlo hablandole encima, como a una persona.
JARVIS_INTERRUMPIBLE=true

# --- Puerta del microfono (solo mientras Jarvis habla) ---
# Impide que un ruido lo interrumpa: el microfono no se abre hasta que el
# sonido se mantiene, y un golpe o una tos no se mantienen.
JARVIS_PUERTA_UMBRAL=0.045
JARVIS_PUERTA_SOSTENIDO_MS=220

# --- Supabase (opcional) ---
# Token: https://supabase.com/dashboard/account/tokens
# Sin esto, Jarvis funciona igual pero sin acceso a la base de datos.
SUPABASE_ACCESS_TOKEN=sbp-pon-tu-token-aqui

# Referencia del proyecto (el id en la URL del dashboard). Si lo dejas vacio,
# Jarvis ve todos tus proyectos y puede administrar la cuenta.
SUPABASE_PROJECT_REF=

# true = solo consultas, imposible modificar datos. Cambiar con cuidado.
SUPABASE_SOLO_LECTURA=true

# OPCIONAL, pero es la diferencia entre ~1.2s y ~0.15s por consulta.
# Conexion directa a Postgres para el catalogo de consultas de arriba. Tiene
# que empezar con postgresql://: NO es la URL del proyecto (https://...), sino
# Supabase > Connect > Transaction pooler, con [YOUR-PASSWORD] reemplazado.
# Jarvis abre estas conexiones SIEMPRE en transaccion de solo lectura.
# Si la dejas vacia, todo funciona igual pero consultando por MCP.
# El acceso desde los paneles no la usa.
SUPABASE_DB_URL=

# Clave publica del proyecto (Settings > API > anon public). Con ella, mas
# SUPABASE_PROJECT_REF y SUPABASE_SERVICE_ROLE_KEY (abajo), la gente entra a
# Jarvis desde los paneles con su sesion de Supabase. Sin alguna de las tres
# ese acceso queda apagado y solo sirven las contrasenas de arriba.
SUPABASE_ANON_KEY=

# Organizacion a la que pertenece todo el que entra desde los paneles. Se crea
# sola al arrancar, y su consumo se le cobra con JARVIS_MARGEN. Vacio = quien
# entra por los paneles es de la casa y no se le cobra.
JARVIS_ORGANIZACION_PANELES=

# --- Imagenes y fichas tecnicas de productos ---
# Buckets de Supabase Storage donde cada archivo se llama como el Codigo del
# producto (305400.png, 305400.pdf). Listarlos exige la service role key
# (Settings > API): nunca sale del servidor. Sin estas tres, Jarvis no ofrece
# la herramienta de mandar archivos. La service role tambien lee los perfiles
# de quien entra desde un panel.
SUPABASE_SERVICE_ROLE_KEY=
JARVIS_BUCKET_IMAGENES=
JARVIS_BUCKET_FICHAS=

# --- Cotizaciones de Jarvis (JV-00001), aparte de las de JH ---
# Id de la fuente con List_ProductosIA y List_ClientesIA (la Base JH), de donde
# salen precios y clientes. La tabla jarvis_cotizaciones y el bucket privado
# se crean con el SQL del README. Sin las cuatro, no se ofrecen cotizaciones.
JARVIS_FUENTE_CATALOGO=
JARVIS_BUCKET_COTIZACIONES=jarvis_cotizaciones
PDFCO_API_KEY=

# Se puede cotizar sobre el coste en vez del nivel del cliente. Que columna es
# el coste se dice en las NOTAS de esa fuente, desde el panel de Fuentes; sin
# eso Jarvis pregunta en vez de adivinar.
# Los precios P1..P7 del catalogo ya incluyen ITBIS y un coste normalmente no,
# asi que Jarvis se lo agrega. Si en esta base el coste ya lo trajera:
# JARVIS_COSTE_CON_ITBIS=true

# --- WhatsApp por Evolution API ---
# Para mandar fotos, fichas y cotizaciones a un numero. Sin las tres, Jarvis no
# ofrece enviar. El numero que envia es el conectado a la instancia.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
# Opcional: otro numero. Si la principal da cualquier error, se reintenta por esta.
EVOLUTION_INSTANCIA_RESPALDO=

# --- Personalizacion ---
JARVIS_NOMBRE=Jarvis
JARVIS_USUARIO=Lucas
JARVIS_CIUDAD=Ciudad de Mexico

# --- Quien puede entrar ---
# Tu contrasena. Obligatoria al hospedar. Quien entra con esta administra
# Jarvis: es el unico que toca fuentes, esquema y consumo.
JARVIS_PASSWORD=

# Una variable mas por cada persona. El id y el nombre salen del sufijo:
# JARVIS_PASSWORD_JORGE crea un usuario "jorge" al que Jarvis llama "Jorge".
# Cada uno tiene su conversacion y su memoria; las fuentes son comunes.
# La pantalla de acceso no pide usuario: la contrasena ya dice quien eres,
# asi que tienen que ser distintas entre si.
# JARVIS_PASSWORD_JORGE=

# Firma las sesiones. Al cambiarla todos vuelven a entrar, asi que es la
# forma de echar a alguien de inmediato.
JARVIS_CLAVE_SECRETA=

# --- Margen sobre OpenAI ---
# Porcentaje que se le cobra a cada organizacion por encima de lo que cobra
# OpenAI. 30 = se factura el costo mas un 30%. Vacio o 0 = al costo.
# Solo aplica a cuentas de organizacion: quien entra por JARVIS_PASSWORD o
# desde un panel es de la casa y no se le cobra margen.
JARVIS_MARGEN=0

# Opcional: un margen distinto para una organizacion. El sufijo es su id, que
# sale en el tablero de Consumo. Pisa a JARVIS_MARGEN.
# JARVIS_MARGEN_51512a3363c7f591=50

# Quienes dan soporte no salen como clientes en el consumo: van juntos bajo un
# solo nombre. El nombre tiene que coincidir entero con el que muestra el
# tablero. Por defecto, Jorge Salamanca, Lucas Marte y Edmond Constantin.
# JARVIS_SOPORTE=Jorge Salamanca,Lucas Marte,Edmond Constantin
# JARVIS_SOPORTE_NOMBRE=NEBO Support

# --- Cobro en agentia ---
# Lo que consume cada organizacion (con el margen) se descuenta de su saldo en
# agentia, con concepto "Jarvis" y el nombre de la persona en la nota. Se
# junta por persona y se manda en centavos enteros: agentia redondea a
# centavos, y cada respuesta sola cuesta menos de uno. Sin las tres primeras
# no se cobra nada. Se cobra desde que se configura, no hacia atras.
JARVIS_CREDITOS_URL=https://app.swordaisolutions.com/api/credits/adjust
JARVIS_CREDITOS_CALLER_ID=
# La API key de esa cuenta. Es un secreto: va en las variables del servidor,
# nunca en el codigo.
JARVIS_CREDITOS_API_KEY=
# Una por organizacion: su clientId en agentia. La de los paneles es PANELES.
# JARVIS_CREDITOS_CLIENTE_PANELES=
# Cada cuanto se manda lo juntado. 5 por defecto.
# JARVIS_CREDITOS_CADA_MINUTOS=5
