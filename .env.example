# Copia este archivo como .env y pon tus claves reales.

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-pon-tu-clave-aqui

# Modo texto. Barato, para lo cotidiano.
OPENAI_MODEL=gpt-5.6-terra

# Modo voz en vivo. El flagship distingue mejor la voz del ruido de fondo y
# acierta mas con nombres tecnicos; el mini cuesta un tercio.
OPENAI_MODELO_VOZ=gpt-realtime-2.1
JARVIS_VOZ=marin

# Cuanto piensa antes de hablar: minimal, low, medium, high, xhigh.
# 'low' es lo recomendado para voz.
JARVIS_ESFUERZO=low

# --- Como escucha ---
# far_field: microfono de portatil o de sala.  near_field: diadema.
JARVIS_MICROFONO=far_field
# Que tan fuerte hay que hablar para que cuente como voz (0 a 1).
JARVIS_UMBRAL_VOZ=0.55
# Silencio necesario para dar tu turno por terminado.
JARVIS_SILENCIO_MS=700
# true = puedes cortarlo hablandole encima, como a una persona.
JARVIS_INTERRUMPIBLE=true

# --- Puerta del microfono (solo mientras Jarvis habla) ---
# Impide que un ruido lo interrumpa: el microfono no se abre hasta que el
# sonido se mantiene, y un golpe o una tos no se mantienen.
JARVIS_PUERTA_UMBRAL=0.045
JARVIS_PUERTA_SOSTENIDO_MS=220

# --- Supabase (opcional) ---
# Token: https://supabase.com/dashboard/account/tokens
# Sin esto, Jarvis funciona igual pero sin acceso a la base de datos.
SUPABASE_ACCESS_TOKEN=sbp-pon-tu-token-aqui

# Referencia del proyecto (el id en la URL del dashboard). Si lo dejas vacio,
# Jarvis ve todos tus proyectos y puede administrar la cuenta.
SUPABASE_PROJECT_REF=

# true = solo consultas, imposible modificar datos. Cambiar con cuidado.
SUPABASE_SOLO_LECTURA=true

# OPCIONAL, pero es la diferencia entre ~1.2s y ~0.15s por consulta.
# Conexion directa a Postgres. Dashboard > Project Settings > Database >
# Connection string > Transaction pooler. Reemplaza [YOUR-PASSWORD].
# Jarvis abre estas conexiones SIEMPRE en transaccion de solo lectura.
# Si la dejas vacia, todo funciona igual pero consultando por MCP.
SUPABASE_DB_URL=

# Clave publica del proyecto (Settings > API > anon public). Hace falta para
# que la gente entre a Jarvis desde los paneles con su sesion de Supabase.
# Sin ella ese acceso queda apagado y solo sirven las contrasenas de arriba.
SUPABASE_ANON_KEY=

# --- Personalizacion ---
JARVIS_NOMBRE=Jarvis
JARVIS_USUARIO=Lucas
JARVIS_CIUDAD=Ciudad de Mexico

# --- Quien puede entrar ---
# Tu contrasena. Obligatoria al hospedar. Quien entra con esta administra
# Jarvis: es el unico que toca fuentes, esquema y consumo.
JARVIS_PASSWORD=

# Una variable mas por cada persona. El id y el nombre salen del sufijo:
# JARVIS_PASSWORD_JORGE crea un usuario "jorge" al que Jarvis llama "Jorge".
# Cada uno tiene su conversacion y su memoria; las fuentes son comunes.
# La pantalla de acceso no pide usuario: la contrasena ya dice quien eres,
# asi que tienen que ser distintas entre si.
# JARVIS_PASSWORD_JORGE=

# Firma las sesiones. Al cambiarla todos vuelven a entrar, asi que es la
# forma de echar a alguien de inmediato.
JARVIS_CLAVE_SECRETA=
