# Copia este archivo como .env y pon tus claves reales.

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-pon-tu-clave-aqui

# Modo texto. Barato, para lo cotidiano.
OPENAI_MODEL=gpt-5.6-terra

# Modo voz en vivo. El mini cuesta un tercio del flagship.
# Cambia a gpt-realtime-2.1 si quieres la voz mas natural.
OPENAI_MODELO_VOZ=gpt-realtime-2.1-mini
JARVIS_VOZ=marin

# --- Supabase (opcional) ---
# Token: https://supabase.com/dashboard/account/tokens
# Sin esto, Jarvis funciona igual pero sin acceso a la base de datos.
SUPABASE_ACCESS_TOKEN=sbp-pon-tu-token-aqui

# Referencia del proyecto (el id en la URL del dashboard). Si lo dejas vacio,
# Jarvis ve todos tus proyectos y puede administrar la cuenta.
SUPABASE_PROJECT_REF=

# true = solo consultas, imposible modificar datos. Cambiar con cuidado.
SUPABASE_SOLO_LECTURA=true

# OPCIONAL, pero es la diferencia entre ~1.2s y ~0.15s por consulta.
# Conexion directa a Postgres. Dashboard > Project Settings > Database >
# Connection string > Transaction pooler. Reemplaza [YOUR-PASSWORD].
# Jarvis abre estas conexiones SIEMPRE en transaccion de solo lectura.
# Si la dejas vacia, todo funciona igual pero consultando por MCP.
SUPABASE_DB_URL=

# --- Personalizacion ---
JARVIS_NOMBRE=Jarvis
JARVIS_USUARIO=Lucas
JARVIS_CIUDAD=Ciudad de Mexico
